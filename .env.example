# SPDX-License-Identifier: AGPL-3.0-or-later
# Copy to .env and adjust. Never commit .env.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_DEBUG=true
# Set to false when serving over plain HTTP on a local network.
PORESIRA_HTTPS=true
PORESIRA_PORT=8000
# 127.0.0.1 serves this computer only; use 0.0.0.0 to serve the lab network.
PORESIRA_BIND_ADDRESS=127.0.0.1

# Docker Compose profile: poste (single computer), labo (server + backups), plateforme (+ Slurm agent).
COMPOSE_PROFILES=poste

# Backups (labo and plateforme profiles, or `docker compose run --rm backup /scripts/backup.sh`).
BACKUP_DIR=./backups

# Folder holding the laboratory's data files (POD5, FASTQ, gel images...), mounted read-only in
# the web and worker containers at this same path. Declare it as a storage backend with
# create_storage_backend, using this exact path as the root.
PORESIRA_DATA_DIR=/srv/poresira-data

# Compute jobs (Slurm). Results go below PORESIRA_COMPUTE_OUTPUT_DIR, one folder per job; the
# cluster must see this and every backend root at the same path.
# PORESIRA_COMPUTE_OUTPUT_DIR=/srv/poresira-data/computing
# Shell line run before the tools, written by the administrator (trusted), e.g. module load dorado/0.9.0
# PORESIRA_COMPUTE_SETUP=
# The commands may be several words. In a container, bind the data folder, which is not mounted
# by default: apptainer exec --nv --bind /srv/poresira-data /opt/dorado.sif dorado
# PORESIRA_DORADO_COMMAND=dorado
# PORESIRA_DORADO_VERSION=0.9.0
# PORESIRA_DORADO_MODELS_DIR=
# PORESIRA_POD5_COMMAND=pod5
# PORESIRA_POD5_VERSION=
# Folder holding sbatch, squeue, sacct and scancel when they are not on the agent's PATH.
# PORESIRA_SLURM_BIN_DIR=
# Seconds between two questions to the scheduler about a running job.
# PORESIRA_COMPUTE_POLL_SECONDS=60
# PORESIRA_SLURM_PARTITION=
# PORESIRA_SLURM_ACCOUNT=
# PORESIRA_SLURM_GPUS=1
# PORESIRA_SLURM_CPUS=8
# PORESIRA_SLURM_MEM_GB=64
# PORESIRA_SLURM_TIME=24:00:00
BACKUP_KEEP_DAYS=30
# uid:gid that should own backup files on the host (run `id` to see yours).
BACKUP_OWNER=1000:1000
BACKUP_INTERVAL_HOURS=24

PORESIRA_DEFAULT_LANGUAGE=en
PORESIRA_TIME_ZONE=Africa/Ouagadougou
PORESIRA_SITE_PREFIX=WBF
PORESIRA_SOURCE_URL=https://github.com/etibiri/poresira
PORESIRA_VERSION=dev

# Database. The owner role runs migrations; the application role has no
# UPDATE/DELETE on audit tables. Docker Compose picks the right one per service.
POSTGRES_DB=poresira
POSTGRES_PORT=5432
POSTGRES_SUPERUSER_PASSWORD=change-me
POSTGRES_OWNER_USER=poresira_owner
POSTGRES_OWNER_PASSWORD=change-me
POSTGRES_APP_USER=poresira_app
POSTGRES_APP_PASSWORD=change-me

# Only for running manage.py or pytest from the host against the Compose database.
POSTGRES_HOST=localhost
POSTGRES_USER=poresira_owner
POSTGRES_PASSWORD=change-me

REDIS_URL=redis://localhost:6379/0

# Trust X-Forwarded-For for audit IP addresses (only behind a trusted reverse proxy).
PORESIRA_TRUST_X_FORWARDED_FOR=false

# Deposits to the European Nucleotide Archive. Set these ONLY in the environment of the deposit
# agent (celery -A config worker --queues deposits), never on the web server. Use an account made
# for PoreSira: Webin-CLI takes the password as a command-line option, so it is visible in the
# process list of the agent's computer while a submission runs.
# ENA_WEBIN_USER=Webin-12345
# ENA_WEBIN_PASSWORD=
# The command of Webin-CLI, which may be several words, e.g. java -jar /opt/webin-cli.jar
# ENA_WEBIN_CLI=webin-cli
# Where the agent writes manifests and Webin-CLI reports (default: <PORESIRA_DATA_DIR>/deposits).
# ENA_WORK_DIR=
# Reading the public archives (sync_public_archives). Only public accession numbers are sent.
# PORESIRA_NCBI_API_KEY=
# PORESIRA_PUBLIC_MIN_INTERVAL=0.4
# Organism written in the BioSample table prepared for NCBI (the package asks for a metagenome).
# PORESIRA_NCBI_ORGANISM=plant metagenome
# ENA_TEST_URL=https://wwwdev.ebi.ac.uk/ena/submit/drop-box/submit
# ENA_PRODUCTION_URL=https://www.ebi.ac.uk/ena/submit/drop-box/submit
